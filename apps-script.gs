const SHEET_NAME='Quotes';const NOTIFY_EMAIL='76pressurewashing@gmail.com';function doPost(e){const ss=SpreadsheetApp.getActiveSpreadsheet();let sh=ss.getSheetByName(SHEET_NAME);if(!sh){sh=ss.insertSheet(SHEET_NAME);sh.appendRow(['Timestamp','Name','Phone','Email','Property Address','Property Type','Square Footage','Services','Preferred Contact','Best Time','Details']);sh.getRange(1,1,1,11).setFontWeight('bold');sh.setFrozenRows(1)}const p=e.parameter||{};const services=e.parameters&&e.parameters.services?e.parameters.services.join(', '):'';sh.appendRow([new Date(),c(p.name),c(p.phone),c(p.email),c(p.address),c(p.propertyType),c(p.squareFeet),c(services),c(p.contactMethod),c(p.bestTime),c(p.details)]);const body=['New quote request from the Seven Six Pressure Washing website','',`Name: ${c(p.name)}`,`Phone: ${c(p.phone)}`,`Email: ${c(p.email)}`,`Property Address: ${c(p.address)}`,`Property Type: ${c(p.propertyType)}`,`Square Footage: ${c(p.squareFeet)||'Not provided'}`,`Services: ${services||'Not provided'}`,`Preferred Contact: ${c(p.contactMethod)}`,`Best Time: ${c(p.bestTime)||'Not provided'}`,'','Additional Details:',c(p.details)||'None'].join('\n');MailApp.sendEmail({to:NOTIFY_EMAIL,subject:`New Quote Request - ${c(p.name)||'Website Lead'}`,body:body,replyTo:c(p.email)||undefined,name:'Seven Six Website'});return ContentService.createTextOutput('OK')}function c(v){return v==null?'':String(v).trim().replace(/[<>]/g,'')}